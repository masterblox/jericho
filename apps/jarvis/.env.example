# Optional override for the local Core bearer token. On macOS, Jericho creates
# and reuses a private `jericho-core-api` Keychain item when this is blank.
JERICHO_API_TOKEN=

# Optional voice. The Core and every configured connector run without Gemini.
GEMINI_API_KEY=
CONDUCTOR_PORT=8787
JERICHO_HOST=127.0.0.1
JERICHO_ALLOWED_ORIGINS=http://localhost:5173

# Remote capture surfaces. Telegram credentials belong to the Hermes gateway;
# Jericho does not own a Telegram client session.
JERICHO_TELEGRAM_GATEWAY_URL=
JERICHO_TELEGRAM_GATEWAY_TOKEN=
# WhatsApp uses a separate authenticated Hermes gateway surface. It remains
# disabled unless both values are present.
JERICHO_WHATSAPP_GATEWAY_URL=
JERICHO_WHATSAPP_GATEWAY_TOKEN=
LINEAR_API_KEY=

# Local/direct truth sources. Named path variables are JSON arrays.
JERICHO_GIT_REPOSITORIES=[]
JERICHO_GITHUB_REPOSITORIES=
JERICHO_CONDUCTOR_ROOTS=[]
JERICHO_OBSIDIAN_VAULT=

# Optional bounded Hermes execution bus. Configure all three values together;
# a partial workspace fails closed and an empty workspace disables execution.
# A configured legacy bus is still unavailable until its operator publishes
# the fresh v1 capability manifest documented in docs/HERMES-EXECUTION-PROTOCOL-V1.md.
JERICHO_HERMES_BUS_ROOT=
JERICHO_HERMES_REPO=
JERICHO_HERMES_BRANCH=
JERICHO_HERMES_POLL_INTERVAL_MS=250
JERICHO_HERMES_MAX_WAIT_MS=900000

# Repository authority is an explicit allowlist. A direct capture must also
# select a configured repository via payload.jerichoScope.repository.
JERICHO_MISSION_REPOSITORY_GRANTS=[]

# Review-only reflection cadence (six hours). Findings remain proposals.
JERICHO_REFLECTION_INTERVAL_MS=21600000

# Optional supervisor bounds.
JERICHO_CONNECTOR_LEASE_MS=30000
JERICHO_CONNECTOR_MAX_PAGES=100
JERICHO_CONNECTOR_POLL_INTERVAL_MS=30000
