# Install as /etc/jericho/vault-gateway.env with mode 0600.
JERICHO_VAULT_GATEWAY_TOKEN=
JERICHO_VAULT_GATEWAY_HOST=127.0.0.1
JERICHO_VAULT_GATEWAY_PORT=8790
JERICHO_VAULT_PATH=/opt/brain
JERICHO_VAULT_RAG_SCRIPT=/opt/data/scripts/vault-rag.py
JERICHO_VAULT_RAG_INDEX=/opt/data/vault-rag-index/bm25_index.json
JERICHO_VAULT_RAG_CACHE=/opt/data/jericho/intel/rag-cache.json
JERICHO_VAULT_CACHE_TTL_MS=86400000
JERICHO_VAULT_SYNC_STALE_MS=3600000
JERICHO_VAULT_COMMAND_TIMEOUT_MS=45000
JERICHO_VAULT_MAX_OUTPUT_BYTES=262144
